model Test {
	id				Int			@id @default(autoincrement())
	name			String
	issn			String?		@unique
	status			JournalStatus
	foundingYear	Int?
	
	organizationId	Int
	organization	Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

	createdAt 		DateTime 	@default(now())
	updatedAt 		DateTime 	@updatedAt
}

