model Actor {
    id				Int			@id @default(autoincrement()) 
    
    type            ActorType

    organization Organization?
    decisionAuthority DecisionAuthority?
    person Person?

    decisionsAsDecisionMaker AwardDecision[] @relation("DecisionMaker")
    decisionsAsRecipient     AwardDecision[] @relation("Recipient")
}

enum ActorType {
    ORGANIZATION
    DECISION_AUTHORITY
    PERSON
}