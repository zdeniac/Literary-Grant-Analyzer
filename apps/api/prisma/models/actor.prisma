model Actor {
    id				Int			@id @default(autoincrement()) 
    
    type            ActorType

    organization Organization?
    decisionBody DecisionBody?

    decisionsAsDecisionMaker AwardDecision[] @relation("DecisionMaker")
    decisionsAsRecipient     AwardDecision[] @relation("Recipient")
}

enum ActorType {
    ORGANIZATION
    DECISION_BODY
}