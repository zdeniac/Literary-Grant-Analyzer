model Journal {
	id				Int			@id @default(autoincrement())
	
	name			String
	issn			String?		@unique
	status			JournalStatus
	format			JournalFormat[]
	foundingYear	Int?
	
	affiliations	JournalAffiliation[]

	createdAt 		DateTime 	@default(now())
	updatedAt 		DateTime 	@updatedAt
}

enum JournalStatus {
	ACTIVE
	PAUSE
	CEASED
}

enum JournalFormat {
	ONLINE
	PRINT
}