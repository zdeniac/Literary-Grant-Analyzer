model Organization {
	id 				Int 		@id @default(autoincrement())
	name 			String		@unique
	address 		String?
	website			String?
	legalForm 		LegalForm
	foundingYear 	Int?

	actorId			Int 		@unique
	actor			Actor @relation(fields: [actorId], references: [id], onDelete: Restrict)
	
	journals		Journal[]
	decisionBodies	DecisionBody[]
	awardSchemes	AwardScheme[]

	createdAt 		DateTime 	@default(now())
	updatedAt 		DateTime 	@updatedAt
}

enum LegalForm {
	LTD
	PLC
	FOUNDATION
	ASSOCIATION
	OTHER
}
