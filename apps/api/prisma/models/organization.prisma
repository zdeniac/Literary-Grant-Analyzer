model Organization {
	id 				Int 		@id @default(autoincrement())
	name 			String		@unique
	address 		String?
	website			String?
	legalForm 		LegalForm
	sector			Sector
	foundingYear 	Int?

	actorId			Int 		@unique
	actor			Actor 		@relation(fields: [actorId], references: [id], onDelete: Restrict)
	
	journalAffiliations		JournalAffiliation[]
	decisionBodies			DecisionBody[]
	awardSchemes			AwardScheme[]

	createdAt 		DateTime 	@default(now())
	updatedAt 		DateTime 	@updatedAt
}

enum LegalForm {
	LTD
	PLC
	FOUNDATION
	ASSOCIATION
	OTHER
}

enum Sector  {
	// állami vagy önkormányzati fenntartású, illetve állami kontroll alatt álló szervezetek
	PUBLIC
	// a civil szektor szervezetei (egyesületek, független alapítványok, nonprofit szervezetek)
	CIVIL
	// a piaci szereplők (jellemzően gazdasági társaságok)
	MARKET
	// egyik kategóriába sem illeszthető
	OTHER
}
