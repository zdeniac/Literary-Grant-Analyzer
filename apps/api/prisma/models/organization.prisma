 model Organization {
	id 				Int 		@id @default(autoincrement())
	
	name 			String		@unique
	nameVariants	String[]
	address 		String?
	website			String?
	legalForm 		LegalForm
	sector			Sector
	foundingYear 	Int?

	actorId			Int 		@unique
	actor			Actor 		@relation(fields: [actorId], references: [id], onDelete: Restrict)
	
	journalAffiliations				JournalAffiliation[]
	decisionAuthorities				DecisionAuthority[]
	awardSchemes					AwardScheme[]
	issuedSourceDocuments			SourceDocument[]

	createdAt 		DateTime 	@default(now())
	updatedAt 		DateTime 	@updatedAt
}

enum LegalForm {
	LTD
	PLC
	FOUNDATION
	ASSOCIATION
	OTHER
}

enum Sector  {
	// állami vagy önkormányzati fenntartású, illetve közvetlen állami kontroll alatt álló szervezetek
	PUBLIC

	// civil szektor szervezetei (egyesületek, önálló alapítványok, nonprofit szervezetek)
	CIVIL

	// piaci szereplők (jellemzően gazdasági társaságok)
	MARKET

	OTHER
}
