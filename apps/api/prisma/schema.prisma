// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
}

model Organization {
	id 				Int 		@id @default(autoincrement())
	name 			String		@unique
	address 		String?
	legalForm 		LegalForm
	foundingYear 	Int?
	
	journals		Journal[]
	decisionBodies	DecisionBody[]
	awardSchemes	AwardScheme[]

	createdAt 		DateTime 	@default(now())
	updatedAt 		DateTime 	@updatedAt
}

model Journal {
	id				Int			@id @default(autoincrement())
	name			String
	issn			String?		@unique
	status			JournalStatus
	foundingYear	Int?
	
	organizationId	Int
	organization	Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

	createdAt 		DateTime 	@default(now())
	updatedAt 		DateTime 	@updatedAt
}

// Döntési testületeket, szervezetek, pl. NKA Szépirodalom Kollégium
model DecisionBody {
	id				Int			@id @default(autoincrement())
	name			String

	organizationId	Int?
    organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

	createdAt 		DateTime 	@default(now())
	updatedAt 		DateTime 	@updatedAt
}

// Támogatási konstrukciók, pl. Kossuth-díj, irodalmi laptámogatás
model AwardScheme {
	id				Int			@id @default(autoincrement())
	name			String
	type			AwardSchemeType

	organizationId 	Int
	organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

	createdAt 		DateTime 	@default(now())
	updatedAt 		DateTime 	@updatedAt
}

enum AwardSchemeType {
	GRANT
	SCHOLARSHIP
	AWARD
}

enum JournalStatus {
	ACTIVE
	PAUSE
	CLOSED
}

enum LegalForm {
	LTD
	PLC
	FOUNDATION
	ASSOCIATION
	OTHER
}
